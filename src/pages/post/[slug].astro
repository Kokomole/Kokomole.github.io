---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../data/content.json';

export function getStaticPaths() {
  const posts = content.posts as any[];
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const ymd = `${String(post.year).slice(2)} / ${pad(post.month)} / ${pad(post.day)}`;
---

<BaseLayout title={post.title} description={post.excerpt} path="/">
  <article>
    <a class="back" href="/">← 返回</a>
    <p class="post-meta-date">{ymd}</p>
    <h1 class="post-h1">{post.title}</h1>
    <div class="prose" set:html={post.html} />

    <footer class="post-footer">
      {post.tags.map((tag: string) => <span class="tag">{tag}</span>)}
      <a href={post.sourceUrl} target="_blank" rel="noopener">在 GitHub 上查看</a>
    </footer>
  </article>
</BaseLayout>
