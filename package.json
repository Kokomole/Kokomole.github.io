{
  "name": "kokomole-blog",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "2014色彩漫游 — Issue-as-CMS static blog",
  "scripts": {
    "sync": "node scripts/sync-issues.mjs",
    "dev": "node scripts/sync-issues.mjs --fixtures && astro dev",
    "build": "node scripts/sync-issues.mjs && astro build",
    "build:local": "node scripts/sync-issues.mjs --fixtures && astro build",
    "build:legacy": "node scripts/sync-issues.mjs --legacy && astro build",
    "encrypt": "node scripts/encrypt.mjs",
    "migrate": "node scripts/migrate-legacy.mjs"
  },
  "dependencies": {
    "astro": "6.4.8",
    "github-slugger": "2.0.0",
    "katex": "0.16.11",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "staticrypt": "3.5.4",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "linkedom": "0.18.14",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}
